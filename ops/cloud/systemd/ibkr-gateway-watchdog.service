[Unit]
Description=Bounded Paper Gateway hang recovery through the existing service owner
After=network.target
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/gateway-recovery-policy.json
ConditionPathExists=/etc/polkit-1/rules.d/00-openclaw-paper-gateway.rules

[Service]
Type=oneshot
User=ibkr
Group=ibkr
Environment=HOME=/home/ibkr
WorkingDirectory=/opt/openclaw/app
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/gateway_watchdog.py
UMask=0077
ProtectSystem=full
TimeoutStartSec=30

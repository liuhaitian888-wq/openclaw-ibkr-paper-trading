[Unit]
Description=Single cloud secretary OpenAI Responses model owner
After=network-online.target ibkr-secretary-inbox.service
ConditionPathExists=/etc/openclaw/credentials/secretary-openai.key
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/SECRETARY_CLOUD_API_ARMED

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/secretary_cloud_api.py
LoadCredential=openai_api_key:/etc/openclaw/credentials/secretary-openai.key
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ibkr/.local/state/openclaw
ProtectHome=read-only
PrivateTmp=yes
MemoryMax=256M
CPUQuota=20%
TimeoutStopSec=150
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

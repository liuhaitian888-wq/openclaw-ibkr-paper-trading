[Unit]
Description=Read-only public macro and SEC intake with existing Telegram outbox
After=network-online.target
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/intelligence-policy.json

[Service]
Type=oneshot
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/intelligence_watch.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
TimeoutStartSec=180
MemoryMax=192M
CPUQuota=15%

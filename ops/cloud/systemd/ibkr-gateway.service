[Unit]
Description=Official IB Gateway (human Paper login required)
Requires=ibkr-display.service
Wants=network-online.target ibkr-desktop.service
After=network-online.target ibkr-display.service ibkr-desktop.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/home/ibkr/Jts
Environment=HOME=/home/ibkr
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/ibkr-gui/Xauthority
ExecStart=/home/ibkr/Jts/ibgateway
Restart=always
RestartSec=30
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
MemoryHigh=1500M
MemoryMax=2000M

[Install]
WantedBy=multi-user.target

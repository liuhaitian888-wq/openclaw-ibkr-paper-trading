[Unit]
Description=Single owner Telegram inbox and direct Python controls
After=network-online.target
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/secretary-policy.json

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/secretary_inbox.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
MemoryMax=128M
CPUQuota=10%
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target

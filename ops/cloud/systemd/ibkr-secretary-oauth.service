[Unit]
Description=Single Hetzner secretary ChatGPT OAuth model owner
After=network-online.target ibkr-secretary-inbox.service
ConditionPathExists=/home/ibkr/.local/state/openclaw/secretary-oauth/auth.json
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/SECRETARY_CLOUD_OAUTH_ARMED
ConditionPathExists=!/home/ibkr/.local/state/openclaw/runtime/SECRETARY_CLOUD_API_ARMED
Conflicts=ibkr-secretary-model.service

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/secretary_cloud_oauth.py
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ibkr/.local/state/openclaw
PrivateTmp=yes
MemoryMax=512M
CPUQuota=20%
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target

[Unit]
Description=Read-only local IBKR cloud evidence

[Service]
Type=oneshot
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
Environment=TWS_PORT=4002
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/host_status.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
TimeoutStartSec=90

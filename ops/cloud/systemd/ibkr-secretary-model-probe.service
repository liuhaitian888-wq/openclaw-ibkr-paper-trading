[Unit]
Description=Explicit one-time native cloud secretary API access probe
ConditionPathExists=/etc/openclaw/credentials/secretary-openai.key

[Service]
Type=oneshot
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/probe_secretary_api.py
LoadCredential=openai_api_key:/etc/openclaw/credentials/secretary-openai.key
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ibkr/.local/state/openclaw
ProtectHome=read-only
PrivateTmp=yes
MemoryMax=128M
TimeoutStartSec=150

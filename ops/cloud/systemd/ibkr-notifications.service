[Unit]
Description=Cloud Paper alerts and PNG reports through Brevo
After=network-online.target
ConditionPathExists=/home/ibkr/.config/openclaw/smtp.json
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/BREVO_ALERTS_ARMED
ConditionPathExists=!/home/ibkr/.local/state/openclaw/runtime/FEISHU_ALERTS_ARMED
ConditionPathExists=!/home/ibkr/.local/state/openclaw/runtime/EMAIL_ALERTS_ARMED

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/feishu_alert_watch.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
MemoryMax=128M
CPUQuota=10%
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

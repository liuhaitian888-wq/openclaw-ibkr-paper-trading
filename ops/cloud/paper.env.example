TWS_HOST=127.0.0.1
TWS_PORT=4002
STREAMING_TWS_HOST=127.0.0.1
STREAMING_TWS_PORT=4002
OPENCLAW_STATE_DIR=/home/ibkr/.local/state/openclaw
NO_PAID_MARKET_DATA_REQUESTS=true
ALLOW_SNAPSHOT_MARKET_DATA=false
TRADING_MODE=PAPER
TRADING_KILL_SWITCH=true
ALLOW_TWS_STAGING=false
ALLOW_PAPER_TRANSMIT=false
TRADING_API_HOST=127.0.0.1
TRADING_API_PORT=8789
# OPENCLAW_API_KEY is generated into a private mode-0600 runtime env file,
# with the same value in ~/.config/openclaw/api_key. Never commit that value.
# Not an authorization mechanism: the exact approved Paper manifest is required.

// Installed root-owned under /etc/polkit-1/rules.d. No scripts or imports.
// ibkr already owns the target process; this grants only its fixed unit restart.
polkit.addRule(function(action, subject) {
    if (subject.user === "ibkr" && action.id === "org.freedesktop.systemd1.manage-units") {
        if (action.lookup("unit") === "ibkr-gateway.service" && action.lookup("verb") === "restart") {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});

// Installed root-owned under /etc/polkit-1/rules.d. No scripts or imports.
// ibkr owns the target process: fixed login-assist start and watchdog restart only.
polkit.addRule(function(action, subject) {
    if (subject.user === "ibkr" && action.id === "org.freedesktop.systemd1.manage-units") {
        if (action.lookup("unit") === "ibkr-gateway.service" && (action.lookup("verb") === "restart" || action.lookup("verb") === "start")) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});

[Unit]
Description=Owner authenticated Telegram numeric limits Mini App
After=network-online.target tailscaled.service
ConditionPathExists=/home/ibkr/.local/state/openclaw/runtime/secretary-policy.json

[Service]
User=ibkr
Group=ibkr
WorkingDirectory=/opt/openclaw/app
ExecStart=/opt/openclaw/venv/bin/python /opt/openclaw/app/ops/cloud/secretary_limits_web.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
MemoryMax=128M
CPUQuota=10%

[Install]
WantedBy=multi-user.target

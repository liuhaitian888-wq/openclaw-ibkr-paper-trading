# Discord handbook bot.
# Keep the real bot token in .env or your shell only. Do not commit it.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_CHANNEL_IDS=1514270735638593616
# Optional but recommended. Run !handbook status, copy "Your user ID", and paste it here.
# Leave empty only while testing; empty means any channel member can summarize.
HANDBOOK_ADMIN_USER_IDS=
HANDBOOK_DIR=handbook
SUMMARY_EVERY_MESSAGES=25
SUMMARY_INTERVAL_SECONDS=900
SUMMARY_COOLDOWN_SECONDS=60

# Feishu custom bot. Prefer keeping real values in .secrets/feishu_webhook.env
# or your shell only. Do not commit real webhook URLs or signing secrets.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-your-hook-id
FEISHU_WEBHOOK_SECRET=replace-with-your-feishu-signing-secret

# Optional read-only IBKR Level I streaming quotes for exactly the configured
# subscribed symbols. Disabled by default; strategy still uses snapshot polling.
STREAMING_MARKET_DATA_ENABLED=0
STREAMING_SYMBOLS=AAPL,MSFT,NVDA
STREAMING_MAX_SYMBOLS=3
STREAMING_STALE_MS=3000
STREAMING_TWS_HOST=127.0.0.1
STREAMING_TWS_PORT=7497
STREAMING_CLIENT_ID=32

# Mode 9 infrastructure flags. These defaults keep the system paper-only,
# observable, and conservative.
MODE9_STANDARD_PROCESS=true
MODE9_MONITORING_LINE_ENABLED=true
ACCOUNT_STATE_MANAGER_ENABLED=true
ACCOUNT_STATE_MANAGER_CONNECTED_TO_MODE9=true
SINGLE_EXECUTION_PROCESS_REQUIRED=true
EXECUTION_WRITER_LOCK_REQUIRED=true
LIVE_TRADING_ENABLED=false
MODE9_BUY_FREEZE=true
ALLOW_PAPER_PROTECTIVE_SELL=true
ALLOW_PAPER_RISK_REDUCTION_SELL=true
ALLOW_MARKET_ORDERS=false
ALLOW_OPTIONS_EXECUTION=false
NO_PAID_MARKET_DATA_REQUESTS=true
ALLOW_REGULATORY_SNAPSHOT=false
ALLOW_SNAPSHOT_MARKET_DATA=false
ALLOW_DELAYED_DATA_FOR_EXECUTION=false
ALLOW_DELAYED_DATA_FOR_REPORTS=true
MARKET_DATA_EXECUTION_REQUIRES_LIVE=true
POSITION_GUARD_ENABLED=true
POSITION_PROTECTION_REPAIR_ENABLED=false
POSITION_PROTECTION_REPORT_ONLY=true
POSITION_PROTECTION_ORDER_TYPE=STP_LMT
POSITION_PROTECTION_OUTSIDE_RTH_REQUIRED=true
POSITION_PROTECTION_AUTO_CONVERT_STP_TO_STP_LMT=false
LOT_LEDGER_ENABLED=true
LOT_LEDGER_RECONCILE_FROM_POSITION=true
SQLITE_AUDIT_ENABLED=true
DAILY_PNL_ENABLED=true
POSITION_SNAPSHOT_ENABLED=true
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_REPORT_ONLY=true
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_REPORT_ONLY=true
TRAILING_PROFIT_ENABLED=true
TRAILING_PROFIT_REPORT_ONLY=true
EVENT_RISK_CONTROL_ENABLED=true
EVENT_RISK_REPORT_ONLY=true
GAP_RISK_MANAGER_ENABLED=true
GAP_RISK_REPORT_ONLY=true
GAP_ESCAPE_ENABLED=true
GAP_ESCAPE_PAPER_ONLY=true
GAP_ESCAPE_EXECUTION_ENABLED=false
OPTIONS_HEDGE_PLANNER_ENABLED=true
OPTIONS_HEDGE_REPORT_ONLY=true
OPTIONS_HEDGE_EXECUTION_ENABLED=false
COLLAR_PLANNER_ENABLED=true
PROTECTIVE_PUT_PLANNER_ENABLED=true
POOL_MANAGER_ENABLED=true
POOL_MANAGER_CONNECTED_TO_MODE9=true
POOL_MANAGER_REPORT_ONLY=true
EVENT_ROUTER_REPORT_ONLY=true
SIX_LAYER_POOLS_ENABLED=true
SIX_LAYER_POOLS_EXECUTION_ACTIVE=false
TRADE_POOL_BUY_EXECUTION_ENABLED=false
REMOVE_PRODUCTION_FIXED_SYMBOLS=true

  "mainPath": [
    "public",
    "cache",
    "layers",
    "telegram"
  ],
  "edges": [
    {
      "id": "public-cache",
      "from": "public",
      "to": "cache",
      "label": "有界定时采集",
      "role": "main"
    },
    {
      "id": "cache-layers",
      "from": "cache",
      "to": "layers",
      "label": "保留数据缺口",
      "role": "main"
    },
    {
      "id": "layers-telegram",
      "from": "layers",
      "to": "telegram",
      "label": "只读筛选",
      "role": "main"
    },
    {
      "id": "owner-scanner",
      "from": "owner",
      "to": "scanner",
      "label": "复用原连接",
      "role": "branch"
    },
    {
      "id": "scanner-layers",
      "from": "scanner",
      "to": "layers",
      "label": "候选交叉核对",
      "role": "branch"
    },
    {
      "id": "telegram-compare",
      "from": "telegram",
      "to": "compare",
      "label": "按需对照",
      "role": "branch"
    },
    {
      "id": "owner-compare",
      "from": "owner",
      "to": "compare",
      "label": "既有回读证据",
      "role": "branch"
    },
    {
      "id": "cache-compare",
      "from": "cache",
      "to": "compare",
      "label": "外部缓存字段",
      "role": "branch"
    }

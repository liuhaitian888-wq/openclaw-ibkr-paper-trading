    },
    {
      "id": "cache",
      "lane": "research",
      "col": 1,
      "type": "database",
      "label": "版本化研究缓存",
      "sublabel": "来源、缺失、退避与覆盖",
      "width": 200
    },
    {
      "id": "layers",
      "lane": "research",
      "col": 2,
      "type": "backend",
      "label": "L1–L3 研究投影",
      "sublabel": "L4–L6 仍需独立证据",
      "width": 200
    },
    {
      "id": "telegram",
      "lane": "viewer",
